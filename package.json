{
  "name": "openwriter-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "privacy": "node scripts/check-skill-privacy.mjs && node scripts/check-fixture-provenance.mjs"
  },
  "devDependencies": {
    "turbo": "^2.4.0"
  },
  "packageManager": "npm@10.5.2",
  "dependencies": {
    "sharp": "^0.34.5"
  }
}
